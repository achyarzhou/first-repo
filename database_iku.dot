        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" BGCOLOR="lightyellow">
        <TR>
            <TD COLSPAN="2" BGCOLOR="lightblue" ALIGN="CENTER">
                <FONT POINT-SIZE="11" COLOR="black">Alokasi Anggaran:<B>433.945.000</B></FONT>
            </TD>
        </TR>
        <TR>
            <TD ALIGN="LEFT" BGCOLOR="#f2f2f2"><B>Persentase Pagu</B></TD>
            <TD ALIGN="RIGHT">32%</TD>
        </TR>
        <TR>
            <TD ALIGN="LEFT" BGCOLOR="#f2f2f2"><B>Target</B></TD>
            <TD ALIGN="RIGHT">80%</TD>
        </TR>
        <TR>
            <TD ALIGN="LEFT" BGCOLOR="#f2f2f2"><B>Realisasi</B></TD>
            <TD ALIGN="RIGHT">0%</TD>
        </TR>
    </TABLE>
>];

