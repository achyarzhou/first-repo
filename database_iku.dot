digraph IKU {
    // Pengaturan Umum Graf
    rankdir=LR; // Mengatur arah graf Left-to-Right
    nodesep=0.5; // Jarak horizontal antar node
    ranksep=1.5; // Jarak vertikal antar level
    splines=true; // Garis edge lebih smooth
    node [shape=box, style=filled, color=lightblue, fontsize=10, fontname="Arial"];
    edge [color=gray, fontsize=10, fontname="Arial"];

    // Subgraf IKU 1
    subgraph cluster_iku1 {
        label="IKU 1: Lulusan Mendapat Pekerjaan yang Layak";
        color=blue;
        style=dashed;

